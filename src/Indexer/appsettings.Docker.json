{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel":{
    "Endpoints": {
      "http":{
        "Url": "http://0.0.0.0:5210"
      }
    }
  },
  "Indexer": {
    "Workers":
    [
      {
        "Name": "pythonExample",
        "Script": "Scripts/example.py",
        "Calls": [
          {
            "Type": "interval",
            "Interval": 30000
          }
        ]
      }
    ],
    "Ldap": {
      "Host": "localhost",
      "Port": 389,
      "UseSsl": false,
      "BindDn": "cn=somecn,dc=somedc",
      "BindPassword": "yourbindpassword",
      "BaseDn": "dc=somedc,dc=somemoredc",
      "UsersOu": "ou=users"
    },
    "SimpleAuth": {
      "Users": [
        {
          "Username": "admin",
          "Password": "unsafePractice.67",
          "Roles": [
            "Admin"
          ]
        }
      ]
    },
    "Server": {
      "BaseUri": "http://localhost:5146",
      "ApiKey": "APIKeyForTheServer"
    },
    "PythonRuntime": "libpython3.14.so",
    "AiProviders": {
      "ollama": {
        "handler": "ollama",
        "baseURL": "http://localhost:11434",
        "Allowlist": [
          ".*"
        ],
        "Denylist": []
      },
      "localAI": {
        "handler": "openai",
        "baseURL": "http://localhost:8080",
        "ApiKey": "Some API key here",
        "Allowlist": [
          ".*"
        ],
        "Denylist": []
      }
    },
    "DefaultVisionModel": "ollama:gemma4:e4b"
  }
}
